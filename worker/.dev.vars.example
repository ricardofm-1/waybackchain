# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
HMAC_SECRET=dev-only-change-me
# Cloudflare's published Turnstile test secret: always passes.
# Use 2x0000000000000000000000000000000AA to test the "always fails" path.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Ethereum: https://dashboard.alchemy.com (an app on Ethereum Mainnet)
ALCHEMY_KEY=
# Solana: https://dashboard.helius.dev
HELIUS_KEY=
# Cardano: https://blockfrost.io (a Cardano mainnet project)
BLOCKFROST_KEY=
# Local dev: the page is served by Trunk on another origin.
ALLOWED_ORIGIN=http://127.0.0.1:8080
